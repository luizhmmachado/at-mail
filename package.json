{
  "name": "@mail/root",
  "private": true,
  "version": "0.1.0",
  "description": "@mail — launcher unificado de e-mail e Google Chat",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "tokens:sync": "node scripts/figma-sync-tokens.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "node --import tsx --test packages/core/test/feed.test.ts packages/core/test/store.test.ts",
    "web": "npm --workspace apps/app run web",
    "ios": "npm --workspace apps/app run ios",
    "android": "npm --workspace apps/app run android",
    "desktop": "npm --workspace apps/desktop run dev"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
