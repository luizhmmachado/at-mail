{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões mínimas do @mail desktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://accounts.google.com/*" }]
    },
    "notification:default"
  ]
}
